# Copy to .env and adjust the values.
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/secure_note_taking
# Required. Use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12
# Comma-separated browser origins allowed to call the API (local dev + deployed frontend).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
